# Every build tree, however it is configured. Listing them one at a time got
# as far as build/ and build-ub/ before a coverage tree turned up untracked.
build*/
# The user-local preset overlay. CMakePresets.json is the tracked one.
CMakeUserPresets.json
cache/
out/
*.exe
*.o
*.obj
*.gcda
*.gcno
*.gcov
.coverage
__pycache__/
.mypy_cache/
